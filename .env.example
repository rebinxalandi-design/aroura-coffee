# The site's public URL, no trailing slash. Required in production --
# metadata (canonical URL, Open Graph/Twitter images), JSON-LD structured
# data, robots.txt, and sitemap.xml all resolve absolute URLs from this.
# Without it, those all silently fall back to http://localhost:3000, which
# breaks social link previews and confuses search engines about the
# canonical domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Secret used to sign admin session cookies (HMAC-SHA256). Required in
# production -- without it, the app falls back to a value that's public in
# this repo's source, letting anyone forge an admin session. Generate one
# with: openssl rand -hex 32
SESSION_SECRET=

# Supabase project credentials (Project Settings -> API in the Supabase
# dashboard). NEXT_PUBLIC_SUPABASE_URL is not secret -- it's just the
# project's base URL. SUPABASE_SERVICE_ROLE_KEY IS secret: it bypasses Row
# Level Security and must never be exposed to the browser (it's only read
# in src/lib/supabase.ts, a server-only module).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
