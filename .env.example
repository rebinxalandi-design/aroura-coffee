# The site's public URL, no trailing slash. Required in production --
# metadata (canonical URL, Open Graph/Twitter images), JSON-LD structured
# data, robots.txt, and sitemap.xml all resolve absolute URLs from this.
# Without it, those all silently fall back to http://localhost:3000, which
# breaks social link previews and confuses search engines about the
# canonical domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
